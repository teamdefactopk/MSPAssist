# MSPAssist backend configuration. Copy to .env and fill in real values.
# NEVER commit .env. All values below are placeholders.

APP_NAME="MSPAssist"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the authoritative database in production.
# For quick local development you may use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mspassist
DB_USERNAME=mspassist
DB_PASSWORD=change-me

# Sessions are used only by the web dashboard (Sanctum SPA auth).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Comma-separated host[:port] list whose browser requests use cookie auth.
# Production example: support.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
SANCTUM_TOKEN_DAYS=30

# Comma-separated proxy IPs (or *) when behind a TLS-terminating proxy.
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends mail inline; "database" queues it for the cron-driven worker.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=support@example.com
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- MSPAssist ---
# Where the Flutter web app is served (used in emailed links).
MSPASSIST_FRONTEND_URL=http://localhost:8000/app
MSPASSIST_TICKET_PREFIX=CC
MSPASSIST_DEFAULT_TIMEZONE=UTC
MSPASSIST_INVITATION_TTL_HOURS=72
MSPASSIST_CLIENT_REOPEN_DAYS=14
MSPASSIST_RESUME_ON_CLIENT_REPLY=true
MSPASSIST_ATTACHMENT_DISK=local
MSPASSIST_ATTACHMENT_MAX_KB=10240
MSPASSIST_SLA_ADMIN_ESCALATION_MINUTES=240
MSPASSIST_SLA_SEND_MAIL=true

# Password for fictional demo accounts created by DemoSeeder (development only).
DEMO_PASSWORD=Demo-Password-2026
